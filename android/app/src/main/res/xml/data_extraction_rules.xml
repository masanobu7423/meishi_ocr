<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (2026-11-02, owner's decision 2): business cards are other people's
     personal data, so nothing goes to the Google cloud backup. A direct phone-to-phone
     transfer (changing phones) still moves everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <!-- device-protected storage: unused by the app, excluded so nothing slips through -->
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
        <include domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
